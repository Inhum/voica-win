<Window x:Class="Voica.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Voica"
        xmlns:ui="clr-namespace:Voica.UI"
        Title="{x:Static l:S.HistoryTitle}" Width="880" Height="460"
        MinWidth="600" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">
    <!-- Layout mirrors the macOS window (spec §7): the list on the left, the record's text on the
         right. A one-column list cannot show a dictation longer than a sentence. -->
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search over the list (spec §7): filters text AND raw_text, on a typing pause. -->
        <Grid Grid.Row="0" Grid.Column="0">
            <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center"
                     TextChanged="OnSearchTextChanged" />
            <!-- WPF has no placeholder: a label behind the box, hidden as soon as it is typed in. -->
            <TextBlock x:Name="SearchPlaceholder" Text="{x:Static l:S.HistSearch}" IsHitTestVisible="False"
                       VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.5" />
        </Grid>
        <!-- The search summary sits at the level of the field, above the text: the bottom line is
             taken by the record's metadata, and on a narrow window one would clip the other. -->
        <TextBlock x:Name="SearchInfo" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"
                   Margin="2,0,0,0" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />

        <ListBox x:Name="List" Grid.Row="1" Grid.Column="0" Margin="0,8,0,10"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnCopy"
                 PreviewKeyDown="OnListKeyDown">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static l:S.BtnCopy}" Click="OnCopy" />
                    <MenuItem x:Name="PlayMenuItem" Header="{x:Static l:S.BtnPlay}" Click="OnPlay" />
                    <Separator />
                    <MenuItem Header="{x:Static l:S.BtnDelete}" Click="OnDelete" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding When}" FontSize="11" Opacity="0.65" />
                        <TextBlock TextWrapping="Wrap" MaxHeight="34" Margin="0,1,0,0"
                                   ui:Highlight.Text="{Binding Preview}"
                                   ui:Highlight.Query="{Binding Query}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1" Grid.Column="2" Margin="0,8,0,10">
            <RichTextBox x:Name="Detail" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         FontSize="14" Padding="6,8,6,8"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
            <!-- An empty history and an empty result are different states (spec §7). -->
            <TextBlock x:Name="EmptyLabel" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.5" IsHitTestVisible="False" Visibility="Collapsed" />
        </Grid>

        <!-- Whole-history action (spec §7), so it stands under the list, apart from the per-record
             buttons on the right. -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="ExportButton" Content="{x:Static l:S.BtnExport}" Width="90" Height="28"
                    Margin="0,0,8,0" Click="OnExport" />
            <Button Content="{x:Static l:S.BtnRefresh}" Width="90" Height="28" Click="OnRefresh" />
        </StackPanel>

        <DockPanel Grid.Row="2" Grid.Column="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="{x:Static l:S.BtnCopy}" Width="90" Height="28" Margin="8,0,0,0" Click="OnCopy" />
                <Button x:Name="PlayButton" Content="{x:Static l:S.BtnPlay}" Width="90" Height="28" Margin="8,0,0,0" Click="OnPlay" />
                <Button x:Name="DeleteButton" Content="{x:Static l:S.BtnDelete}" Width="90" Height="28" Margin="8,0,0,0" Click="OnDelete" />
            </StackPanel>
            <!-- The record's metadata, and transient messages ("Copied", "Playing…") over it. -->
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="2,0,0,0"
                       FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
