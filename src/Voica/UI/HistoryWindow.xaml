<Window x:Class="Voica.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Voica"
        Title="{x:Static l:S.HistoryTitle}" Width="720" Height="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search over the list (spec §7): filters text AND raw_text, on a typing pause. -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock x:Name="SearchInfo" DockPanel.Dock="Right" VerticalAlignment="Center"
                       Margin="12,0,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            <Grid HorizontalAlignment="Left" Width="250">
                <TextBox x:Name="SearchBox" Height="26" VerticalContentAlignment="Center"
                         TextChanged="OnSearchTextChanged" />
                <!-- WPF has no placeholder: a label behind the box, hidden as soon as it is typed in. -->
                <TextBlock x:Name="SearchPlaceholder" Text="{x:Static l:S.HistSearch}" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.5" />
            </Grid>
        </DockPanel>

        <DataGrid x:Name="Grid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeRows="False"
                  RowHeight="26"
                  MouseDoubleClick="OnCopy"
                  SelectionChanged="OnSelectionChanged"
                  PreviewKeyDown="OnGridKeyDown">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static l:S.BtnCopy}" Click="OnCopy" />
                    <MenuItem x:Name="PlayMenuItem" Header="{x:Static l:S.BtnPlay}" Click="OnPlay" />
                    <Separator />
                    <MenuItem Header="{x:Static l:S.BtnDelete}" Click="OnDelete" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static l:S.ColWhen}" Binding="{Binding When}" Width="150" />
                <DataGridTextColumn Header="{x:Static l:S.ColText}" Binding="{Binding Preview}" Width="*" />
                <DataGridTextColumn Header="{x:Static l:S.ColLang}" Binding="{Binding Lang}" Width="70" />
                <DataGridTextColumn Header="{x:Static l:S.ColDur}" Binding="{Binding Duration}" Width="60" />
                <DataGridTextColumn Header="{x:Static l:S.ColModel}" Binding="{Binding ModelName}" Width="150" />
                <DataGridTextColumn Header="{x:Static l:S.ColAudio}" Binding="{Binding AudioMark}" Width="55" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CopyButton" Content="{x:Static l:S.BtnCopy}" Width="90" Height="28" Margin="0,0,8,0" Click="OnCopy" />
            <Button x:Name="PlayButton" Content="{x:Static l:S.BtnPlay}" Width="90" Height="28" Margin="0,0,8,0" Click="OnPlay" />
            <Button x:Name="DeleteButton" Content="{x:Static l:S.BtnDelete}" Width="90" Height="28" Margin="0,0,8,0" Click="OnDelete" />
            <Button Content="{x:Static l:S.BtnRefresh}" Width="90" Height="28" Margin="0,0,8,0" Click="OnRefresh" />
            <!-- Whole-history action (spec §7), separate from the per-record buttons above. -->
            <Button x:Name="ExportButton" Content="{x:Static l:S.BtnExport}" Width="90" Height="28" Margin="16,0,8,0" Click="OnExport" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Window>
