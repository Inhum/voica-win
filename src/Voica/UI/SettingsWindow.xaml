<Window x:Class="Voica.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Voica"
        Title="{x:Static l:S.SettingsTitle}" Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Info dot: long explanations live in a tooltip instead of a wall of grey text
             (parity with the macOS Settings window). -->
        <Style x:Key="InfoDot" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x24D8;" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Bottom actions (shared across tabs) -->
        <Grid DockPanel.Dock="Bottom" Margin="4,10,4,0">
            <Button Content="{x:Static l:S.BtnClose}" HorizontalAlignment="Right" Width="90" Height="28" IsCancel="True" Click="OnClose" />
        </Grid>

        <TabControl x:Name="Tabs" SelectionChanged="OnTabChanged">
            <!-- ============ General: engine · API key · updates · reset (spec §2.5/§9/§10/§11) ============ -->
            <TabItem Header="{x:Static l:S.TabGeneral}">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static l:S.LblEngine}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="EngineCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="OnEngineChanged" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="ModelStatusText" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
                        <Button x:Name="DownloadModelButton" Content="{x:Static l:S.BtnDownloadModel}" Width="90" Height="24"
                                Margin="8,0,0,0" Click="OnDownloadModel" />
                    </StackPanel>
                    <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:S.EngineHint}" />

                    <Separator Margin="0,12" />

                    <TextBlock Text="{x:Static l:S.LblApiKey}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid>
                        <PasswordBox x:Name="KeyBox" Height="26" VerticalContentAlignment="Center" />
                        <TextBox x:Name="KeyBoxVisible" Height="26" VerticalContentAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="ShowKeyCheck" Content="{x:Static l:S.ChkShow}" VerticalAlignment="Center" Margin="0,0,16,0"
                                  Checked="OnToggleShowKey" Unchecked="OnToggleShowKey" />
                        <Button x:Name="ValidateButton" Content="{x:Static l:S.BtnValidate}" Width="84" Height="26" Margin="0,0,8,0" Click="OnValidateKey" />
                        <Button x:Name="SaveKeyButton" Content="{x:Static l:S.BtnSave}" Width="76" Height="26" Click="OnSaveKey" />
                    </StackPanel>
                    <TextBlock x:Name="KeyStatusText" Margin="0,6,0,0" Opacity="0.8"
                               TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" />
                    <!-- First run without a key must not be a dead end (spec §11.3): shown only
                         with the cloud engine selected AND no key, in normal colour — three grey
                         hints already sit nearby and a fourth would be lost among them. No button
                         on purpose: the engine switch is right above and visible. -->
                    <TextBlock x:Name="NoKeyHint" Visibility="Collapsed" Margin="0,6,0,0"
                               TextWrapping="Wrap" Text="{x:Static l:S.KeyNoKeyHint}" />

                    <Separator Margin="0,12" />

                    <Button Content="{x:Static l:S.BtnResetSettings}" Width="150" Height="26"
                            HorizontalAlignment="Left" Click="OnResetSettings" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:S.ResetMsg}" />
                </StackPanel>
            </TabItem>

            <!-- ============ Dictation: mode · hotkey · output (spec §4/§5) ============ -->
            <TabItem Header="{x:Static l:S.TabDictation}">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static l:S.LblDictationMode}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="ModeCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="OnModeChanged" />

                    <TextBlock Text="{x:Static l:S.LblHotkey}" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="KeyCombo" Width="170" SelectionChanged="OnKeyChanged" />
                        <Button x:Name="CustomKeyButton" Content="{x:Static l:S.BtnCustom}" Width="86" Height="26" Margin="8,0,0,0" Click="OnCustomKey" />
                        <!-- Double tap belongs to the key, so it sits on the key's row (as on macOS). -->
                        <CheckBox x:Name="DoubleTapCheck" Content="{x:Static l:S.ChkDoubleTap}" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Checked="OnDoubleTapChanged" Unchecked="OnDoubleTapChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.DoubleTapHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="CurrentHotkeyText" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.HotkeyHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <!-- Only when a bare Left Alt meets the system's Alt+Shift layout switch (spec §4). -->
                    <TextBlock x:Name="HotkeyLayoutWarning" Visibility="Collapsed" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="#B35C00"
                               Text="{x:Static l:S.HotkeyLayoutWarning}" />

                    <TextBlock Text="{x:Static l:S.LblOutput}" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <ComboBox x:Name="OutputCombo" Width="260" HorizontalAlignment="Left" SelectionChanged="OnOutputChanged" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <CheckBox x:Name="OverlayCheck" Content="{x:Static l:S.ChkOverlay}" VerticalAlignment="Center"
                                  Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.OverlayHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <Separator Margin="0,14,0,10" />

                    <TextBlock Text="{x:Static l:S.LblCloudSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />

                    <TextBlock Text="{x:Static l:S.LblSttModel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="SttModelCombo" Width="300" HorizontalAlignment="Left" SelectionChanged="OnSttModelChanged" />

                    <TextBlock Text="{x:Static l:S.LblLanguage}" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <ComboBox x:Name="LanguageCombo" Width="300" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" Text="{x:Static l:S.SttHint}" />

                    <CheckBox x:Name="NotifyInsertCheck" Content="{x:Static l:S.ChkNotify}" Margin="0,12,0,0"
                              Checked="OnNotifyInsertChanged" Unchecked="OnNotifyInsertChanged" />

                    <Separator Margin="0,12" />

                    <!-- Rules that change words (spec §6.3/§6.4) — each with its own switch, so a
                         rule that ever gets somebody's words wrong can be escaped without an
                         app update. -->
                    <TextBlock Text="{x:Static l:S.LblCleanup}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="FillersCheck" Content="{x:Static l:S.ChkFillers}" VerticalAlignment="Center"
                                  Checked="OnFillersChanged" Unchecked="OnFillersChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.FillersHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox x:Name="QuotesCheck" Content="{x:Static l:S.ChkQuotes}" VerticalAlignment="Center"
                                  Checked="OnQuotesChanged" Unchecked="OnQuotesChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.QuotesHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Vocabulary: terms + rules + AI correction (spec §6/§6.2/§6.1) ============ -->
            <TabItem Header="{x:Static l:S.TabVocabulary}">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static l:S.LblVocabulary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.VocabHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <TextBox x:Name="VocabularyBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnVocabularyTextChanged" LostFocus="OnVocabularyChanged" />
                    <TextBlock x:Name="VocabCounter" HorizontalAlignment="Right" Opacity="0.7" Margin="0,2,0,0" />

                    <Separator Margin="0,12" />

                    <!-- Rules first, AI second (spec §6.2 above §6.1): what always works and costs
                         nothing, then the optional extra on top. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="TermRulesCheck" Content="{x:Static l:S.ChkTermRules}" VerticalAlignment="Center"
                                  Checked="OnTermRulesChanged" Unchecked="OnTermRulesChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.TermRulesHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox x:Name="LlmCheck" Content="{x:Static l:S.ChkLlm}" VerticalAlignment="Center"
                                  Checked="OnLlmChanged" Unchecked="OnLlmChanged" />
                        <TextBlock Style="{StaticResource InfoDot}">
                            <TextBlock.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static l:S.LlmHint}" TextWrapping="Wrap" MaxWidth="360" /></ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="LlmStatusText" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,4"
                               MaxWidth="500" HorizontalAlignment="Left" />
                    <!-- Model picker: only meaningful while AI correction is on (spec §6.1). -->
                    <StackPanel x:Name="ChatModelPanel" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="{x:Static l:S.LblChatModel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="ChatModelCombo" Width="300" SelectionChanged="OnChatModelChanged" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

            <!-- ============ Data: audio · retention · local model · delete all (spec §8/§2.5/§11) ============ -->
            <TabItem Header="{x:Static l:S.TabData}">
                <StackPanel Margin="12">
                    <CheckBox x:Name="StoreAudioCheck" Content="{x:Static l:S.ChkStoreAudio}" Margin="0,2"
                              Checked="OnStoreAudioChanged" Unchecked="OnStoreAudioChanged" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{x:Static l:S.LblRetention}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="RetentionBox" Width="60" LostFocus="OnRetentionChanged" />
                        <TextBlock Text="{x:Static l:S.RetentionSuffix}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
                    </StackPanel>

                    <Separator Margin="0,12" />

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DeleteModelButton" Content="{x:Static l:S.BtnDeleteModel}" Width="110" Height="26"
                                Click="OnDeleteModel" />
                        <TextBlock x:Name="ModelDiskText" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.8" />
                    </StackPanel>

                    <Separator Margin="0,12" />

                    <Button Content="{x:Static l:S.BtnDeleteAll}" Width="150" Height="28"
                            HorizontalAlignment="Left" Foreground="#C0392B" Click="OnDeleteAllData" />
                </StackPanel>
            </TabItem>

            <!-- ============ Network: system proxy · which route requests take (spec §9.5/§11.4) ============ -->
            <TabItem Header="{x:Static l:S.TabNetwork}">
                <StackPanel Margin="12">
                    <TextBlock Text="{x:Static l:S.LblProxy}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <CheckBox x:Name="SystemProxyCheck" Content="{x:Static l:S.ChkUseSystemProxy}" Margin="0,2"
                              Checked="OnSystemProxyChanged" Unchecked="OnSystemProxyChanged" />
                    <!-- Where the route goes today. Separate from the error message on purpose
                         (§9.5): the error names the address, this says where the address came from. -->
                    <TextBlock x:Name="ProxyRouteText" Margin="0,10,0,0" Opacity="0.8"
                               TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="500"
                               HorizontalAlignment="Left" Text="{x:Static l:S.ProxyHint}" />
                </StackPanel>
            </TabItem>

            <!-- ============ About: version · privacy · updates · links (spec §10/§12) ============ -->
            <TabItem Header="{x:Static l:S.TabAbout}">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Resources/voica-app.png" Width="56" Height="56"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Voica" FontSize="20" FontWeight="Bold" />
                            <TextBlock x:Name="AboutVersionText" Opacity="0.75" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{x:Static l:S.AboutTagline}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.8" Text="{x:Static l:S.AboutPrivacy}" />

                    <Separator Margin="0,12" />

                    <TextBlock Text="{x:Static l:S.LblUpdates}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="CheckNowButton" Content="{x:Static l:S.BtnCheckNow}" Width="120" Height="26"
                                Click="OnCheckUpdatesNow" />
                        <Button x:Name="DownloadUpdateButton" Width="170" Height="26" Margin="8,0,0,0"
                                Visibility="Collapsed" Click="OnOpenUpdatePage" />
                    </StackPanel>
                    <!-- Its own line, capped and wrapping: an update error carries the proxy
                         message (§9.5), which does not fit beside two buttons (§11.4). -->
                    <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,0" Opacity="0.8"
                               TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" />
                    <CheckBox x:Name="CheckUpdatesCheck" Content="{x:Static l:S.ChkCheckUpdates}" Margin="0,10,0,0"
                              Checked="OnCheckUpdatesChanged" Unchecked="OnCheckUpdatesChanged" />

                    <Separator Margin="0,12" />

                    <TextBlock>
                        <Hyperlink NavigateUri="https://github.com/Inhum/voica-win" RequestNavigate="OnNavigate">
                            <Run Text="{x:Static l:S.BtnGitHub}" />
                        </Hyperlink>
                        <Run Text="  ·  " Foreground="Gray" />
                        <Hyperlink NavigateUri="https://boosty.to/voica" RequestNavigate="OnNavigate">
                            <Run Text="{x:Static l:S.BtnSupport}" />
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap"
                               Text="{x:Static l:S.SupportHint}" />
                    <TextBlock Margin="0,8,0,0" Opacity="0.6" FontSize="11" Text="{x:Static l:S.AboutLicense}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
